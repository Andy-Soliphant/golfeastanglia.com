<section class="register-section" id="register">
  <div class="reg-grid">
    <div class="reg-left">
      <span class="section-eyebrow">Investment</span>
      <h2 class="section-title">Reserve your <em>place</em></h2>
      <div class="price-big">£1,995 <span>per person</span></div>
      <div class="price-note">Twin share basis · Single supplement available on request · Deposit: £500pp</div>
      <div class="inc-list">
        <div class="inc-line">Return Eurotunnel crossings from Folkestone</div>
        <div class="inc-line">4 nights luxury accommodation at Le Manoir</div>
        <div class="inc-line">4 rounds championship golf with buggy</div>
        <div class="inc-line">Daily PGA coaching with Pascal Ogden</div>
        <div class="inc-line">Private sommelier wine evening</div>
        <div class="inc-line">Dinner in Montreuil-sur-Mer</div>
        <div class="inc-line">Calais Vins on departure</div>
        <div class="inc-line">All green fees, transfers &amp; daily breakfast</div>
        <div class="inc-line">Personal coaching development plan</div>
      </div>
      <div class="pascal-contact-box">
        <div class="box-label">Contact Pascal directly</div>
        <div class="c-line">📧 pascalgolf@hotmail.co.uk</div>
        <div class="c-line">📱 07814 633071</div>
        <div class="c-line" style="margin-top:14px;padding-top:14px;border-top:1px solid rgba(255,255,255,0.08);"><a href="/pascal" style="color:var(--gold);font-size:11px;letter-spacing:1.5px;text-transform:uppercase;">Full profile &amp; coaching details →</a></div>
      </div>
    </div>
    <div class="reg-form">
      <h3>Register Your Interest</h3>
      <p>Places are strictly limited to 14 guests. Complete this form and we will be in touch to confirm availability and next steps. A deposit of £500pp secures your place.</p>
      <div id="form-success" style="display:none; background:rgba(201,168,76,0.12); border:1px solid var(--gold); padding:24px; text-align:center; margin-bottom:20px;">
        <div style="font-family:'Cormorant Garamond',serif; font-size:22px; color:var(--navy); margin-bottom:8px;">Thank you — we'll be in touch shortly.</div>
        <div style="font-size:12px; color:var(--grey); line-height:1.65;">Your registration has been received. We'll contact you within 48 hours to confirm availability and next steps.</div>
      </div>
      <form id="cote-dopale-form" name="cote-dopale-interest" method="POST" data-netlify="true" netlify-honeypot="bot-field">
        <input type="hidden" name="form-name" value="cote-dopale-interest">
        <input type="hidden" name="bot-field" style="display:none">
        <div class="fg-row">
          <div class="fg"><label>First Name</label><input type="text" name="first-name" placeholder="First name" required></div>
          <div class="fg"><label>Last Name</label><input type="text" name="last-name" placeholder="Last name" required></div>
        </div>
        <div class="fg"><label>Email Address</label><input type="email" name="email" placeholder="your@email.com" required></div>
        <div class="fg"><label>Mobile Number</label><input type="tel" name="mobile" placeholder="07..."></div>
        <div class="fg-row">
          <div class="fg"><label>Handicap Index</label><input type="text" name="handicap" placeholder="e.g. 14.2"></div>
          <div class="fg"><label>How did you hear about us?</label>
            <select name="referral"><option value="">Select...</option><option>Pascal Ogden</option><option>Golf club / pro recommendation</option><option>Personal recommendation</option><option>Golf East Anglia website</option><option>Social media</option><option>Other</option></select>
          </div>
        </div>
        <div class="fg"><label>Anything you'd like us to know?</label><textarea name="message" rows="3" placeholder="Number of guests, dietary requirements, questions..."></textarea></div>
        <button type="submit" class="btn-submit">Submit Registration of Interest</button>
        <div class="form-disc">Registering does not constitute a booking. We will contact you directly to confirm availability, pricing and next steps. Your details will not be shared with any third party.</div>
      </form>
    </div>
  </div>
</section>

