<meta charset="UTF-8">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>The Côte d'Opale Collection — Golf East Anglia</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400;1,600&family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
*, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }
:root {
  --navy:#1a2535; --navy-mid:#243040; --gold:#c9a84c; --gold-light:#e8d5a3;
  --cream:#f8f4ed; --white:#ffffff; --grey:#6b7280; --light-grey:#e5e0d8; --text:#2d3748;
}
html { scroll-behavior:smooth; }
body { font-family:'Montserrat',sans-serif; background:var(--cream); color:var(--text); overflow-x:hidden; }

nav { position:fixed; top:0; left:0; right:0; z-index:100; background:rgba(26,37,53,0.96); backdrop-filter:blur(8px); padding:0 60px; display:flex; align-items:center; justify-content:space-between; height:60px; border-bottom:1px solid rgba(201,168,76,0.2); }
.nav-brand { font-family:'Cormorant Garamond',serif; font-size:18px; font-weight:400; color:var(--gold); letter-spacing:1px; text-decoration:none; }
.nav-links { display:flex; gap:32px; align-items:center; }
.nav-links a { font-size:10px; font-weight:600; letter-spacing:2.5px; text-transform:uppercase; color:rgba(255,255,255,0.65); text-decoration:none; transition:color 0.2s; }
.nav-links a:hover { color:var(--gold); }
.nav-cta { background:var(--gold) !important; color:var(--navy) !important; padding:9px 22px; }

.hero { position:relative; height:100vh; min-height:620px; overflow:hidden; }
.hero-bg { position:absolute; inset:0; background-image:url('/images/cote-dopale-hero.jpg'); background-size:cover; background-position:center 35%; animation:heroZoom 14s ease-out forwards; }
@keyframes heroZoom { from { transform:scale(1.06); } to { transform:scale(1.0); } }
.hero-overlay { position:absolute; inset:0; background:linear-gradient(to bottom, rgba(26,37,53,0.2) 0%, rgba(26,37,53,0.5) 45%, rgba(26,37,53,0.9) 100%); }
.hero-content { position:absolute; bottom:0; left:0; right:0; padding:0 80px 72px; animation:fadeUp 1s ease 0.3s both; }
@keyframes fadeUp { from { opacity:0; transform:translateY(28px); } to { opacity:1; transform:translateY(0); } }
.hero-eyebrow { font-size:10px; font-weight:600; letter-spacing:4px; text-transform:uppercase; color:var(--gold); margin-bottom:14px; }
.hero-title { font-family:'Cormorant Garamond',serif; font-size:clamp(46px,6vw,74px); font-weight:300; color:var(--white); line-height:1.05; margin-bottom:18px; }
.hero-title em { font-style:italic; color:var(--gold-light); }
.hero-sub { font-size:12px; font-weight:400; letter-spacing:2.5px; text-transform:uppercase; color:rgba(255,255,255,0.68); margin-bottom:36px; }
.hero-bottom { display:flex; align-items:flex-end; justify-content:space-between; flex-wrap:wrap; gap:24px; }
.hero-stats { display:flex; gap:48px; flex-wrap:wrap; }
.stat-num { font-family:'Cormorant Garamond',serif; font-size:38px; font-weight:300; color:var(--white); line-height:1; display:block; }
.stat-label { font-size:9px; font-weight:600; letter-spacing:2px; text-transform:uppercase; color:var(--gold); display:block; margin-top:4px; }
.hero-cta { display:inline-block; background:var(--gold); color:var(--navy); font-size:10px; font-weight:700; letter-spacing:3px; text-transform:uppercase; text-decoration:none; padding:17px 40px; transition:background 0.2s, transform 0.2s; white-space:nowrap; }
.hero-cta:hover { background:var(--gold-light); transform:translateY(-2px); }

section { padding:90px 80px; }
.section-eyebrow { font-size:10px; font-weight:600; letter-spacing:4px; text-transform:uppercase; color:var(--gold); margin-bottom:12px; display:block; }
.section-title { font-family:'Cormorant Garamond',serif; font-size:clamp(34px,4vw,50px); font-weight:300; color:var(--navy); line-height:1.1; margin-bottom:16px; }
.section-title em { font-style:italic; color:#4a5568; }

/* PASCAL */
.pascal-section { background:var(--navy); padding:90px 80px; }
.pascal-grid { display:grid; grid-template-columns:320px 1fr; gap:72px; align-items:start; }
.pascal-photo { width:100%; aspect-ratio:3/4; overflow:hidden; border:1px solid rgba(201,168,76,0.35); position:relative; }
.pascal-photo img { width:100%; height:100%; object-fit:cover; object-position:center top; display:block; }
.pascal-name-plate { background:var(--gold); padding:14px 20px; text-align:center; }
.pascal-name-plate .pname { font-family:'Cormorant Garamond',serif; font-size:22px; font-weight:400; color:var(--navy); display:block; }
.pascal-name-plate .ptitle { font-size:9px; font-weight:700; letter-spacing:2px; text-transform:uppercase; color:var(--navy-mid); margin-top:3px; display:block; }
.pascal-content .section-eyebrow { color:var(--gold); }
.pascal-content .section-title { color:var(--white); }
.pascal-content .section-title em { color:var(--gold-light); font-style:italic; }
.pascal-quote { font-family:'Cormorant Garamond',serif; font-size:19px; font-weight:300; font-style:italic; color:var(--gold-light); line-height:1.7; border-left:3px solid var(--gold); padding-left:24px; margin:28px 0 32px; }
.creds-grid { display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:28px; }
.cred { background:rgba(255,255,255,0.04); border:1px solid rgba(201,168,76,0.18); border-left:3px solid var(--gold); padding:16px 20px; }
.cred-title { font-size:10px; font-weight:700; letter-spacing:1.5px; text-transform:uppercase; color:var(--gold); margin-bottom:6px; }
.cred-body { font-size:12px; font-weight:300; color:rgba(255,255,255,0.75); line-height:1.6; }
.coaches-block { background:rgba(201,168,76,0.07); border:1px solid rgba(201,168,76,0.25); padding:22px 26px; }
.coaches-label { font-size:9px; font-weight:700; letter-spacing:3px; text-transform:uppercase; color:var(--gold); margin-bottom:14px; }
.coach-line { font-size:14px; font-weight:300; color:rgba(255,255,255,0.85); line-height:1; margin-bottom:12px; display:flex; align-items:baseline; gap:10px; }
.coach-line:last-child { margin-bottom:0; }
.coach-name { font-family:'Cormorant Garamond',serif; font-size:18px; font-weight:400; color:var(--white); }
.coach-desc { font-size:11px; color:rgba(255,255,255,0.55); font-style:italic; }

/* PROGRAMME */
.programme-section { background:var(--white); }
.prog-grid { display:grid; grid-template-columns:1fr 1fr; gap:60px; margin-top:48px; align-items:center; }
.prog-img { height:440px; overflow:hidden; }
.prog-img img { width:100%; height:100%; object-fit:cover; display:block; }
.prog-text p { font-size:14px; font-weight:300; line-height:1.9; color:var(--grey); margin-bottom:18px; }
.prog-text p strong { color:var(--navy); font-weight:600; }

/* COURSES */
.courses-section { background:var(--cream); padding:90px 0; }
.courses-header { padding:0 80px 48px; }
.courses-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:3px; }
.course-card { position:relative; overflow:hidden; height:360px; cursor:pointer; }
.course-card img { width:100%; height:100%; object-fit:cover; transition:transform 0.6s ease; display:block; }
.course-card:hover img { transform:scale(1.06); }
.c-overlay { position:absolute; inset:0; background:linear-gradient(to top, rgba(26,37,53,0.94) 0%, rgba(26,37,53,0.08) 55%); transition:background 0.3s; }
.course-card:hover .c-overlay { background:linear-gradient(to top, rgba(26,37,53,0.97) 0%, rgba(26,37,53,0.25) 55%); }
.c-info { position:absolute; bottom:0; left:0; right:0; padding:28px 36px; }
.c-day { font-size:9px; font-weight:700; letter-spacing:3px; text-transform:uppercase; color:var(--gold); margin-bottom:7px; }
.c-name { font-family:'Cormorant Garamond',serif; font-size:30px; font-weight:400; color:var(--white); line-height:1.1; margin-bottom:4px; }
.c-sub { font-size:10px; font-weight:500; letter-spacing:1.5px; text-transform:uppercase; color:var(--gold-light); margin-bottom:10px; }
.c-desc { font-size:12px; font-weight:300; color:rgba(255,255,255,0.7); line-height:1.6; max-height:0; overflow:hidden; transition:max-height 0.4s ease; }
.course-card:hover .c-desc { max-height:80px; }

/* RHYTHM */
.rhythm-section { background:var(--navy); }
.rhythm-section .section-title { color:var(--white); }
.rhythm-section .section-title em { color:var(--gold-light); }
.rhythm-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:2px; margin-top:50px; }
.rhythm-item { background:rgba(255,255,255,0.04); border-top:3px solid var(--gold); padding:34px 26px; }
.r-time { font-family:'Cormorant Garamond',serif; font-size:34px; font-weight:300; color:var(--gold); line-height:1; margin-bottom:12px; }
.r-title { font-size:10px; font-weight:700; letter-spacing:2px; text-transform:uppercase; color:var(--white); margin-bottom:10px; }
.r-desc { font-size:12px; font-weight:300; color:rgba(255,255,255,0.58); line-height:1.75; }

/* INCLUSIONS */
.inclusions-section { background:var(--cream); }
.inc-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:20px; margin-top:50px; }
.inc-item { background:var(--white); border:1px solid var(--light-grey); border-top:3px solid var(--gold); padding:30px 22px; text-align:center; }
.inc-icon { font-size:26px; margin-bottom:12px; display:block; }
.inc-title { font-family:'Cormorant Garamond',serif; font-size:18px; font-weight:400; color:var(--navy); margin-bottom:8px; }
.inc-desc { font-size:11px; font-weight:300; color:var(--grey); line-height:1.7; }

/* ITINERARY */
.itinerary-section { background:var(--white); }
.itin-stack { display:flex; flex-direction:column; gap:3px; margin-top:50px; }
.itin-day { position:relative; overflow:hidden; min-height:340px; display:flex; align-items:flex-end; }
.itin-bg { position:absolute; inset:0; background-size:cover; background-position:center; transition:transform 0.5s ease; }
.itin-day:hover .itin-bg { transform:scale(1.03); }
.itin-overlay { position:absolute; inset:0; background:linear-gradient(to top, rgba(17,26,36,0.92) 0%, rgba(17,26,36,0.45) 55%, rgba(17,26,36,0.15) 100%); }
.itin-content { position:relative; z-index:2; padding:36px 48px; width:100%; }
.i-num { font-family:'Cormorant Garamond',serif; font-size:64px; font-weight:300; color:rgba(201,168,76,0.35); line-height:1; margin-bottom:2px; }
.i-date { font-size:9px; font-weight:700; letter-spacing:3px; text-transform:uppercase; color:var(--gold); margin-bottom:10px; }
.i-title { font-family:'Cormorant Garamond',serif; font-size:28px; font-weight:400; color:var(--white); margin-bottom:8px; }
.i-desc { font-size:13px; font-weight:300; color:rgba(255,255,255,0.78); line-height:1.75; max-width:760px; margin-bottom:14px; }
.i-tags { display:flex; flex-wrap:wrap; gap:6px; }
.i-tag { font-size:9px; font-weight:700; letter-spacing:1.5px; text-transform:uppercase; color:var(--gold); background:rgba(17,26,36,0.7); border:1px solid rgba(201,168,76,0.3); padding:4px 10px; }

/* REGISTER */
.register-section { background:var(--navy); }
.reg-grid { display:grid; grid-template-columns:1fr 1fr; gap:64px; align-items:start; }
.reg-left .section-title { color:var(--white); }
.reg-left .section-title em { color:var(--gold-light); }
.price-big { font-family:'Cormorant Garamond',serif; font-size:76px; font-weight:300; color:var(--white); line-height:1; margin:20px 0 4px; }
.price-big span { font-size:18px; font-style:italic; color:var(--gold-light); font-family:'Cormorant Garamond',serif; }
.price-note { font-size:11px; color:rgba(255,255,255,0.45); margin-bottom:32px; }
.inc-list { display:flex; flex-direction:column; gap:10px; margin-bottom:32px; }
.inc-line { display:flex; align-items:center; gap:12px; font-size:13px; font-weight:300; color:rgba(255,255,255,0.8); }
.inc-line::before { content:'✦'; color:var(--gold); font-size:10px; flex-shrink:0; }
.pascal-contact-box { background:rgba(201,168,76,0.09); border:1px solid rgba(201,168,76,0.3); padding:22px 26px; }
.pascal-contact-box .box-label { font-size:9px; font-weight:700; letter-spacing:3px; text-transform:uppercase; color:var(--gold); margin-bottom:14px; }
.pascal-contact-box .c-line { font-size:14px; font-weight:300; color:rgba(255,255,255,0.85); margin-bottom:8px; display:flex; align-items:center; gap:10px; }
.pascal-contact-box .c-line:last-child { margin-bottom:0; }
.reg-form { background:var(--cream); padding:44px; }
.reg-form h3 { font-family:'Cormorant Garamond',serif; font-size:30px; font-weight:400; color:var(--navy); margin-bottom:6px; }
.reg-form p { font-size:12px; color:var(--grey); margin-bottom:28px; line-height:1.65; }
.fg { margin-bottom:16px; }
.fg label { display:block; font-size:9px; font-weight:700; letter-spacing:2px; text-transform:uppercase; color:var(--navy); margin-bottom:6px; }
.fg input, .fg select, .fg textarea { width:100%; padding:12px 14px; border:1px solid var(--light-grey); background:var(--white); font-family:'Montserrat',sans-serif; font-size:13px; color:var(--navy); outline:none; transition:border-color 0.2s; }
.fg input:focus, .fg select:focus, .fg textarea:focus { border-color:var(--gold); }
.fg-row { display:grid; grid-template-columns:1fr 1fr; gap:16px; }
.btn-submit { width:100%; background:var(--navy); color:var(--gold); border:2px solid var(--gold); padding:17px; font-family:'Montserrat',sans-serif; font-size:10px; font-weight:700; letter-spacing:3px; text-transform:uppercase; cursor:pointer; transition:background 0.2s, color 0.2s; margin-top:8px; }
.btn-submit:hover { background:var(--gold); color:var(--navy); }
.form-disc { font-size:10px; color:var(--grey); margin-top:14px; line-height:1.6; }

footer { background:#111a24; padding:28px 80px; display:flex; align-items:center; justify-content:space-between; border-top:1px solid rgba(201,168,76,0.12); }
.ft-brand { font-family:'Cormorant Garamond',serif; font-size:18px; color:var(--gold); }
.ft-links { display:flex; gap:28px; }
.ft-links a { font-size:10px; font-weight:500; letter-spacing:2px; text-transform:uppercase; color:rgba(255,255,255,0.38); text-decoration:none; }
.ft-copy { font-size:10px; color:rgba(255,255,255,0.28); }

.ba-strip{border-bottom:1px solid var(--bdr);background:rgba(183,157,100,0.045);}
.ba-inner{max-width:1400px;margin:0 auto;padding:11px 48px;display:flex;align-items:baseline;gap:18px;flex-wrap:wrap;}
.ba-lbl{font-family:var(--sans);font-size:9px;letter-spacing:0.3em;text-transform:uppercase;color:var(--gold);white-space:nowrap;}
.ba-inner p{font-family:var(--sans);font-size:13px;font-weight:200;color:var(--tmid);margin:0;line-height:1.5;}
.ba-inner a{color:var(--gold);text-decoration:none;border-bottom:1px solid var(--gold-b);padding-bottom:1px;}
.ba-inner a:hover{border-bottom-color:var(--gold);}
@media(max-width:768px){.ba-inner{padding:9px 20px;gap:8px;}.ba-inner p{font-size:12px;}}
</style>
  <link rel="canonical" href="https://www.golfeastanglia.com/cote-dopale-collection">
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"TouristDestination",
"name":"The C\u00f4te d'Opale Collection",
"url":"https://www.golfeastanglia.com/cote-dopale-collection",
"description":"Links golf on the Opal Coast of northern France, reachable from East Anglia and combined with a stay on the English east coast.",
"touristType":["Golf travellers","Golf societies"],
"provider":{"@type":"TravelAgency","name":"Golf East Anglia","url":"https://www.golfeastanglia.com/"}}
</script>
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[
{"@type":"ListItem","position":1,"name":"Golf East Anglia","item":"https://www.golfeastanglia.com/"},
{"@type":"ListItem","position":2,"name":"C\u00f4te d'Opale","item":"https://www.golfeastanglia.com/cote-dopale-collection"}]}
</script>
</head>
<body>

<nav>
  <a href="https://www.golfeastanglia.com" class="nav-brand">Golf East Anglia</a>
  <div class="nav-links">
    <a href="#pascal">Your Coach</a>
    <a href="#courses">The Courses</a>
    <a href="#itinerary">Itinerary</a>
    <a href="#register" class="nav-cta">Reserve a Place</a>
  </div>
</nav>

<div class="ba-strip">
  <div class="ba-inner">
    <span class="ba-lbl">By Arrangement</span>
    <p>For a private commission &mdash; a course closed for a morning, arrival by air &mdash; see <a href="/by-arrangement">By Arrangement</a>.</p>
  </div>
</div>


<div class="hero">
  <div class="hero-bg"></div>
  <div class="hero-overlay"></div>
  <div class="hero-content">
    <div class="hero-eyebrow">Golf East Anglia · Exclusive Collection · Northern France</div>
    <h1 class="hero-title">Côte d'Opale<br><em>Golf Collection</em></h1>
    <div class="hero-sub">12–16 September 2026 · Hosted by Pascal Ogden PGA Professional</div>
    <div class="hero-bottom">
      <div class="hero-stats">
        <div><span class="stat-num">4</span><span class="stat-label">Championship Rounds</span></div>
        <div><span class="stat-num">4</span><span class="stat-label">Nights Inclusive</span></div>
        <div><span class="stat-num">14</span><span class="stat-label">Guests Maximum</span></div>
        <div><span class="stat-num">£1,995</span><span class="stat-label">Per Person All-Inclusive</span></div>
      </div>
      <a href="#register" class="hero-cta">Reserve Your Place</a>
    </div>
  </div>
</div>

<section class="pascal-section" id="pascal">
  <div class="pascal-grid">
    <div>
      <div class="pascal-photo">
        <img loading="lazy" decoding="async" src="/images/cote-dopale-pascal-ogden.jpg" alt="Pascal Ogden PGA Professional">
      </div>
      <div class="pascal-name-plate">
        <span class="pname">Pascal Ogden</span>
        <span class="ptitle">PGA Professional · Host &amp; Coach</span>
      </div>
    </div>
    <div class="pascal-content">
      <span class="section-eyebrow">Your Host &amp; Coach</span>
      <h2 class="section-title">Learn from someone<br><em>trained at the very top</em></h2>
      <div class="pascal-quote">"I've spent my career obsessing over what makes a great golfer. I've been fortunate to learn from three of the world's finest coaches, compete on professional tour, and share everything I've learned with golfers who want to genuinely improve. This trip is something I've wanted to do for years — great golf, great courses, great food and great company. Come and join me."</div>
      <div class="creds-grid">
        <div class="cred">
          <div class="cred-title">3 Professional Tour Wins</div>
          <div class="cred-body">Europro Tour &amp; 1836 Tours — a proven competitor at the highest domestic level</div>
        </div>
        <div class="cred">
          <div class="cred-title">Forensic Methodology</div>
          <div class="cred-body">Every lesson broken down simply — easy to digest and immediately applicable on course</div>
        </div>
        <div class="cred">
          <div class="cred-title">Personally Scouted</div>
          <div class="cred-body">Pascal has played every course, stayed at Le Manoir and eaten at every restaurant on this trip</div>
        </div>
        <div class="cred">
          <div class="cred-title">Guaranteed Improvement</div>
          <div class="cred-body">A bespoke development plan goes home with every guest — the coaching continues after the trip</div>
        </div>
      </div>
      <div class="coaches-block">
        <div class="coaches-label">Trained by three of the world's finest coaches</div>
        <div class="coach-line">
          <span class="coach-name">Graham Walker</span>
          <span class="coach-desc">Coach to Tommy Fleetwood &amp; European Tour professionals</span>
        </div>
        <div class="coach-line">
          <span class="coach-name">Alan Thompson</span>
          <span class="coach-desc">Renowned swing coach</span>
        </div>
        <div class="coach-line">
          <span class="coach-name">Phil Kenyon</span>
          <span class="coach-desc">The world's leading putting coach — trusted by Major champions</span>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="programme-section" id="programme">
  <span class="section-eyebrow">The Programme</span>
  <h2 class="section-title">Learn it in the morning.<br><em>Play it in the afternoon.</em></h2>
  <div class="prog-grid">
    <div class="prog-text">
      <p>Pascal's coaching follows a single principle: <strong>one focused theme per day.</strong> Two hours of structured technical work in the morning — video analysis, data capture, clear takeaways. That afternoon, 18 holes on a championship course applying exactly what you learned. The feedback loop between lesson and real course is what makes improvement tangible within the week.</p>
      <p>Just 90 minutes from Calais, the Côte d'Opale is one of Europe's finest and least discovered golf destinations. Pine forest, wild dune links and classic heathland — <strong>four entirely different tests of golf</strong>, all within minutes of each other.</p>
      <p>This is a small, exclusive group. <strong>Fourteen guests maximum.</strong> Real individual attention from Pascal, dinners that feel like a private gathering, and a group small enough that everyone knows each other by day two.</p>
    </div>
    <div class="prog-img">
      <img loading="lazy" decoding="async" src="/images/cote-dopale-championship-fairway.jpg" alt="Championship fairway">
    </div>
  </div>
</section>

<section class="courses-section" id="courses">
  <div class="courses-header">
    <span class="section-eyebrow">Four Championship Courses</span>
    <h2 class="section-title">Four entirely different<br><em>tests of golf</em></h2>
  </div>
  <div class="courses-grid">
    <div class="course-card">
      <img loading="lazy" decoding="async" src="/images/cote-dopale-le-touquet-la-foret.jpg" alt="La Forêt Le Touquet">
      <div class="c-overlay"></div>
      <div class="c-info">
        <div class="c-day">Day 1 · Sunday 13 September</div>
        <div class="c-name">La Forêt</div>
        <div class="c-sub">Le Touquet · Heathland Classic</div>
        <div class="c-desc">A superb opener. Le Touquet's classic heathland layout — find your rhythm with Pascal on hand throughout every hole.</div>
      </div>
    </div>
    <div class="course-card">
      <img loading="lazy" decoding="async" src="/images/cote-dopale-belle-dune.jpg" alt="Golf de Belle Dune">
      <div class="c-overlay"></div>
      <div class="c-info">
        <div class="c-day">Day 2 · Monday 14 September</div>
        <div class="c-name">Golf de Belle Dune</div>
        <div class="c-sub">Fort-Mahon · Dune Links · Jean-Manuel Rossi, 1992</div>
        <div class="c-desc">Spectacular dune links carved through a protected nature reserve. Wild terrain, ocean air, and a course that surprises every golfer who plays it.</div>
      </div>
    </div>
    <div class="course-card">
      <img loading="lazy" decoding="async" src="/images/cote-dopale-hardelot-les-pins.jpg" alt="Les Pins Golf d'Hardelot">
      <div class="c-overlay"></div>
      <div class="c-info">
        <div class="c-day">Day 3 · Tuesday 15 September</div>
        <div class="c-name">Golf d'Hardelot — Les Pins</div>
        <div class="c-sub">Hardelot · Tom Simpson · Top 30 Continental Europe</div>
        <div class="c-desc">The jewel of the Côte d'Opale. Tom Simpson's pine-framed masterpiece — deep bunkers, immaculate condition, one of France's most beautiful golf settings.</div>
      </div>
    </div>
    <div class="course-card">
      <img loading="lazy" decoding="async" src="/images/cote-dopale-le-touquet-la-mer.jpg" alt="La Mer Le Touquet">
      <div class="c-overlay"></div>
      <div class="c-info">
        <div class="c-day">Day 4 · Wednesday 16 September · Farewell Round</div>
        <div class="c-name">La Mer — Le Touquet</div>
        <div class="c-sub">Harry Colt, 1931 · Six-time French Open Host</div>
        <div class="c-desc">The perfect finale. A Harry Colt masterpiece. Celebrate in style at La Mer's exceptional clubhouse before the journey home via Calais Vins.</div>
      </div>
    </div>
  </div>
</section>

<section class="rhythm-section">
  <span class="section-eyebrow">A Typical Day</span>
  <h2 class="section-title">The daily <em>rhythm</em></h2>
  <div class="rhythm-grid">
    <div class="rhythm-item"><div class="r-time">09:00</div><div class="r-title">Morning Coaching</div><div class="r-desc">Two hours with Pascal. One focused theme. Video analysis and data capture so you can see real improvement in real time.</div></div>
    <div class="rhythm-item"><div class="r-time">11:30</div><div class="r-title">To the Course</div><div class="r-desc">Private transfer to the day's championship venue. Pascal briefs the group on the course and the day's on-course focus.</div></div>
    <div class="rhythm-item"><div class="r-time">12:00</div><div class="r-title">18 Holes</div><div class="r-desc">Apply the morning's lesson on a world-class course — with Pascal on hand throughout every round, every day.</div></div>
    <div class="rhythm-item"><div class="r-time">19:30</div><div class="r-title">Evening &amp; Dinner</div><div class="r-desc">Monday: private sommelier wine evening. Tuesday: dinner in Montreuil-sur-Mer, one of northern France's finest restaurant towns.</div></div>
  </div>
</section>

